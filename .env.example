POSTGRES_USER=autoai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=autoai
DATABASE_URL=postgresql://autoai:changeme@bd:5432/autoai
VITE_API_URL=http://localhost:8000
BACKEND_URL=http://backend:8000
SCRAPER_CRON=0 3 * * 0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17

# Directorio base permitido para /ingest (el `file` se interpreta relativo a él).
INGEST_DIR=/data

# Orígenes CORS permitidos (CSV). En prod, poner la URL real del frontend.
CORS_ORIGINS=http://localhost:5173

# Seguridad de /chat e /ingest (INERTES por defecto).
# RATE_LIMIT_PER_MIN=0  -> 0 desactiva el rate-limit; p. ej. 30 = 30 req/min/IP.
# Nota: el límite es por-proceso; con uvicorn --workers 4 se multiplica x4.
RATE_LIMIT_PER_MIN=0
# CHAT_API_KEY vacía desactiva la auth; si se define, exige cabecera X-Api-Key.
CHAT_API_KEY=
